# Empty keeps the current local demonstration. No server credentials belong here.
# To use server password login, medical records, and clinical AI, copy this file
# to .env.local, set e.g. http://127.0.0.1:3000, then restart Vite.
# Patient profiles and patient consultations remain a local demonstration.
# Consultation-linked drafts stay local and are not automatically uploaded.
VITE_API_BASE_URL=
