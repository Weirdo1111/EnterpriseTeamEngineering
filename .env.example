# Empty keeps the current local demonstration. No server credentials belong here.
# To verify real password login, copy this file to .env.local and set the deployed
# authentication server origin, e.g. http://127.0.0.1:3000, then restart Vite.
# This checkout has no patient/consultation HTTP adapters yet. Server accounts
# stop at /connection; they never read or write the local clinical demo dataset.
VITE_API_BASE_URL=
