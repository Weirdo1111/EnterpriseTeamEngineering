MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=
MYSQL_DATABASE=doctor_platform
JWT_SECRET=replace_me
PORT=3000

# Generate independently from JWT_SECRET, e.g. openssl rand -hex 32.
AUTH_CODE_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
NODE_ENV=development
# Email only: disabled | console (explicit development/test only) | provider.
# Leave existing email settings unchanged. SMS no longer follows this switch.
AUTH_DELIVERY_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Real SMS is disabled. No Twilio credentials are needed or used.
# disabled | local-inbox (ONLY NODE_ENV=development, local MySQL, private directory).
# Production must use disabled; local-inbox in production makes startup fail.
SMS_DELIVERY_MODE=disabled
# Absolute directory OUTSIDE this repository, owned by you with permissions 700.
# Create on macOS: mktemp -d "${TMPDIR%/}/ete-sms.XXXXXX"
# Copy the returned absolute path here; .env does not run shell commands.
SMS_TEST_INBOX_DIR=
