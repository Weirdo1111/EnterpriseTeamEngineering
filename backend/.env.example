MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=
MYSQL_DATABASE=doctor_platform
JWT_SECRET=replace_me
PORT=3000

# Generate independently from JWT_SECRET, e.g. openssl rand -hex 32.
AUTH_CODE_SECRET=replace_with_a_separate_random_secret_at_least_32_characters
NODE_ENV=development
# Email: disabled | provider. Local console delivery has been removed.
# provider requires a Resend key and a sender accepted by Resend.
AUTH_DELIVERY_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=

# SMS is suspended pending selection of a suitable provider.
# No Twilio credentials or local SMS simulation are used.
SMS_DELIVERY_MODE=disabled

# Tencent face login: server only. Enable after trusted cloud enrollment + SQL mapping.
TENCENT_FACE_ENABLED=false
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Required: use the same region as the cloud group/person registration.
TENCENT_FACE_REGION=ap-guangzhou
# Optional STS session token; leave empty for permanent access keys.
TENCENT_SESSION_TOKEN=
# Model 3.0 only. Require IsMatch=true AND Score >= this value (60..100).
TENCENT_FACE_THRESHOLD=60
